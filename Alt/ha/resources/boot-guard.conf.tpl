# fusionpbx-ha: PostgreSQL boot guard configuration (AUTO-GENERATED by
# fusionpbx-ha.sh - local changes will be overwritten)
#
# No secrets in this file (mode 644): the agent probe is plain HTTP and
# the PostgreSQL probe authenticates via the postgres user's .pgpass
# (the repmgr@peer line written by the installer). The guard itself is
# /usr/lib/fusionpbx-ha/pg-boot-guard.sh, wired into postgresql.service
# via an ExecStartPre=+ drop-in; the automatic rejoin (0.3.29) is
# /usr/lib/fusionpbx-ha/pg-auto-rejoin.sh + fusionpbx-ha-auto-rejoin.service,
# and it reads this same file.
BG_PEER_IP="@@PEER_IP@@"
BG_PGDATA="@@PGDATA@@"
BG_PG_PORT="@@PG_PORT@@"
BG_AGENT_PORT="@@AGENT_PORT@@"
BG_ATTEMPTS="@@ATTEMPTS@@"
BG_SLEEP="@@SLEEP@@"
BG_PG_PASSFILE="/var/lib/pgsql/.pgpass"
BG_REPMGR_USER="@@REPMGR_USER@@"
BG_REPMGR_DB="@@REPMGR_DB@@"
BG_REPMGR_CONF_PATH="@@REPMGR_CONF@@"
BG_REPAIR_FLAG="/run/fusionpbx-ha/repair-start.flag"
BG_NODE_ROLE="data"
BG_NODE_NAME="@@NODE_NAME@@"
BG_PG_SERVICE="@@PG_SERVICE@@"
BG_REPMGRD_SERVICE="@@REPMGRD_SERVICE@@"
BG_LSYNCD_SERVICE="@@LSYNCD_SERVICE@@"
BG_REJOIN_ATTEMPTS="@@REJOIN_ATTEMPTS@@"
BG_REJOIN_SLEEP="@@REJOIN_SLEEP@@"
BG_MAX_GAP_MB="@@MAX_GAP_MB@@"
# 0.3.36: the ROOT-START RESCUE (see pg-auto-rejoin.sh): the wait for the
# rescued PostgreSQL to answer psql and for its WAL receiver to attach
# to the peer (the zombie detector). Rendered knobs - a slow catchup on
# a big cluster may need more attach tries.
BG_RESCUE_ANSWER_TRIES="@@RESCUE_ANSWER_TRIES@@"
BG_RESCUE_ANSWER_SLEEP="@@RESCUE_ANSWER_SLEEP@@"
BG_RESCUE_ATTACH_TRIES="@@RESCUE_ATTACH_TRIES@@"
BG_RESCUE_ATTACH_SLEEP="@@RESCUE_ATTACH_SLEEP@@"
# 0.3.41: the status collector - after a completed rejoin the snapshot is
# refreshed at once (the rejoined node's widget flips to standby/streaming
# immediately; the PEER's snapshot updates at its own next cron tick)
BG_STATUS_SCRIPT="@@STATUS_SCRIPT@@"
