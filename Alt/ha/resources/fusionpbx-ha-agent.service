[Unit]
Description=FusionPBX HA role agent (primary/standby HTTP probe for haproxy)
Documentation=file:/usr/share/doc/fusionpbx-ha/DESIGN.md
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
# Runs as root: cluster.conf is mode 600 root-only (it holds database
# credentials). The agent only reads it and answers GET /primary with
# 200/503 - it accepts no other input (see DESIGN.md section 14.4).
ExecStart=/usr/bin/python3 /usr/lib/fusionpbx-ha/role-agent.py
Restart=always
RestartSec=2

# Hardening: the agent needs no write access anywhere
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
