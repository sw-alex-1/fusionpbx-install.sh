# fusionpbx-ha: route SQL traffic to the current PostgreSQL primary
# (AUTO-GENERATED by fusionpbx-ha.sh - local changes will be overwritten)
#
# Loaded by haproxy.service from ALT RPM (layout verified on haproxy
# 3.4.6-alt1): the unit passes BOTH -f /etc/haproxy/haproxy.cfg and
# -f /etc/haproxy/conf.d - this fragment lives in conf.d and leaves the
# package-managed main config untouched.
#
# Traffic goes to port 5432 of each data node; the HEALTH CHECK is an
# HTTP GET /primary on the role-agent port of the same node. A backend
# enters rotation only when its local PostgreSQL is the cluster primary.

listen postgres_primary
    bind 127.0.0.1:@@HAPROXY_PORT@@
    mode tcp
    # Long-lived SQL connections (FreeSWITCH, php-fpm keep-alive): override
    # the 1-minute client/server timeouts from the main config defaults.
    timeout client 1d
    timeout server 1d
    timeout connect 10s
    option httpchk
    http-check send meth GET uri /primary
    default-server inter 3s fall 2 rise 1 check port @@AGENT_PORT@@
    server @@NODE1_NAME@@ @@NODE1_IP@@:5432 check
    server @@NODE2_NAME@@ @@NODE2_IP@@:5432 check
