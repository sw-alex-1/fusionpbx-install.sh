-- fusionpbx-ha: media file sync (AUTO-GENERATED by fusionpbx-ha.sh)
-- Managed file - local changes will be overwritten by the next
-- fusionpbx-ha.sh --repair run.
--
-- Mirrors ONLY /var/lib/freeswitch/storage (recordings, voicemail, faxes):
-- file names are call UUIDs (write-once, no collisions), each file is born
-- on exactly one node, therefore two opposing push streams are safe.
--
-- delete=true propagates deletions made in the UI to the peer node.
-- The receiving side is restricted by the forced rrsync command in
-- authorized_keys (see DESIGN.md section 6.3).
--
-- Unit (lsyncd.service, ALT RPM 2.3.1-alt2) hardcodes this exact path.

settings {
        logfile = "/var/log/lsyncd/lsyncd.log",
        statusFile = "/var/log/lsyncd/lsyncd.status",
        statusInterval = 20,
        inotifyMode = "CloseWrite",
}

sync {
        default.rsync,
        source    = "@@SYNC_DIR@@",
        target    = "root@@@PEER_IP@@:@@SYNC_DIR@@",
        delay     = @@SYNC_DELAY@@,
        delete    = true,
        rsync     = {
                binary   = "/usr/bin/rsync",
                archive  = true,
                compress = true,
                verbose  = false,
                _extra   = { "--fuzzy" },
                rsh      = "/usr/bin/ssh -i /etc/fusionpbx-ha/sync_key -o UserKnownHostsFile=/etc/fusionpbx-ha/known_hosts -o StrictHostKeyChecking=accept-new -o BatchMode=yes",
        },
}
