# fusionpbx-ha: repmgr configuration (AUTO-GENERATED by fusionpbx-ha.sh)
# Managed file - local changes will be overwritten by the next
# fusionpbx-ha.sh --repair run.
# Layout facts verified against ALT RPM postgresql16-repmgr 5.5.0-alt5:
#   config: /etc/repmgr/repmgr.conf, daemon: repmgr.service (User=postgres)
# repmgr 5.x parameter reference (invalid names are only WARNINGS in the
# log, but a silently ignored monitor interval changes the failover RTO):
#   monitor_interval_secs = repmgrd upstream poll (NOT monitoring_interval)
#   no service_promote_command: repmgr 5.3+ "smart promote" uses
#   pg_promote() as user postgres - a systemd reload would NOT promote.
node_id=@@NODE_ID@@
node_name=@@NODE_NAME@@
# 0.3.33: NO password in conninfo - repmgr prints the connection string
# verbatim (WARNING "unable to ping ..." lines, the "pg_rewind command
# is ..." DETAIL with --source-server built from the PEER's node record)
# and a password here ends up in the console output, repmgrd.log and
# the journal. The postgres system user's .pgpass (written by the
# installer's ha_write_pgpass, mode 600) authenticates every libpq
# connection repmgr itself makes - including pg_rewind's --source-server
# (it inherits this conninfo minus the password). Records written into
# the metadata DB by older versions are stripped by
# ha_scrub_conninfo_secrets().
conninfo='host=@@NODE_IP@@ port=@@PG_PORT@@ user=@@REPMGR_USER@@ dbname=@@REPMGR_DB@@ connect_timeout=5@@CONNINFO_EXTRA@@'
data_directory='@@PGDATA@@'
pg_bindir='/usr/bin'
replication_type=physical
log_file='/var/log/repmgr/repmgrd.log'
log_level=INFO
monitor_interval_secs=5
reconnect_attempts=3
reconnect_interval=5
failover=@@FAILOVER_MODE@@
priority=100
# used by repmgr/repmgrd for edge paths (node rejoin, clone stop);
# ha_install_sudoers() makes them work for User=postgres
service_start_command='sudo systemctl start postgresql'
service_stop_command='sudo systemctl stop postgresql'
service_restart_command='sudo systemctl restart postgresql'
service_reload_command='sudo systemctl reload postgresql'
@@PROMOTE_LINE@@
@@FOLLOW_LINE@@
