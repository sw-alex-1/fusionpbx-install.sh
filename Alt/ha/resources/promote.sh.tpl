#!/bin/sh
# fusionpbx-ha: repmgr promote wrapper (AUTO-GENERATED by fusionpbx-ha.sh)
# Managed file - local changes will be overwritten by the next
# fusionpbx-ha.sh --repair run.
#
# WHY THIS WRAPPER EXISTS (see DESIGN.md changelog 0.3):
# synchronous_standby_names is set with the STANDBY node name and is stored
# in postgresql.auto.conf - which means it is CLONED onto every standby.
# Without this wrapper, a promoted node would wait for a sync standby with
# a stale name (itself-before-promotion) and FREEZE every write commit.
#
# Runs as user postgres from repmgrd; local psql goes through peer auth.
#
# HOW (changelog 0.3.2): ALTER SYSTEM cannot run during recovery, so the
# value is cleared by editing postgresql.auto.conf + SIGHUP (the pattern
# recommended by repmgr for synchronous replication). The reloaded empty
# value becomes effective the moment the node is promoted.
#
# WHY THE APP RESTART (changelog 0.3.24): a hard power-off of the old
# primary never sends TCP RST - the local applications (php-fpm workers,
# FreeSWITCH) sit on sockets to the dead node retransmitting for
# tcp_retries2 (~15-30 minutes). The bench failover test: promote
# successful in ~30s, haproxy routing, role-agent 200, entry point OK
# with the app credentials - and still an endless web-UI spinner plus
# phones stuck in 'sip: auth' on requests caught mid-flight. try-restart
# (restarts only what is active) drops the stale sockets; the apps
# reconnect through 127.0.0.1:<haproxy> immediately. Runs via the
# installer's sudoers drop-in (restart-only verbs); when sudo is missing
# the promote still succeeds - the apps then heal only when their
# sockets time out.

REPMGR_CONF="${REPMGR_CONF:-/etc/repmgr/repmgr.conf}"

_psh_datadir="$(psql -tAc "SHOW data_directory" 2>/dev/null | tr -d ' \r')"
_psh_auto="${_psh_datadir:-}/postgresql.auto.conf"

if [ -n "$_psh_datadir" ] && [ -f "$_psh_auto" ]; then
    _psh_ssn="$(psql -tAc "SHOW synchronous_standby_names" 2>/dev/null | tr -d ' \r')"
    if [ -n "$_psh_ssn" ]; then
        if grep -q "^[[:space:]]*synchronous_standby_names" "$_psh_auto" 2>/dev/null; then
            sed -i "s|^[[:space:]]*synchronous_standby_names[[:space:]]*=.*|synchronous_standby_names = ''|" "$_psh_auto" 2>/dev/null
        else
            echo "synchronous_standby_names = ''" >> "$_psh_auto"
        fi
        psql -q -c "SELECT pg_reload_conf();" >/dev/null 2>&1
        echo "fusionpbx-ha promote.sh: synchronous_standby_names='$_psh_ssn' cleared before promote" >&2
    fi
else
    # Never block the failover itself - promote anyway, loudly.
    echo "fusionpbx-ha promote.sh: WARNING: cannot locate postgresql.auto.conf (writes may stall until repaired)" >&2
fi

# Promote FIRST (the failover itself), then bring the local applications
# back - never the other way around.
# 0.3.35: the systemctl call is ABSOLUTE (the sudoers patterns are absolute
# - a bare 'systemctl' leaves the match to sudo's PATH resolution, one more
# way to fail) and the FIRST LINE of the captured error is printed - the
# 27.10 13:57 promote swallowed the reason ('>/dev/null 2>&1') and all
# three restarts died silently in the same second (the rules worked from
# every other context; the reason never reached the log).
# 0.3.36: the path is RENDERED (the resolved systemctl of THIS node -
# /usr/bin/systemctl on some layouts, /sbin/systemctl on the ALT repmgr
# RPM's world; the sudoers alias covers every existing path). The 27.10
# forensics: the real killer was deeper - postgres could not EXECUTE sudo
# at all (EACCES) - the installer's ha_sudo_heal fixes that one at every
# install/repair point; this printout names it if it ever returns.
if /usr/bin/repmgr standby promote -f "$REPMGR_CONF"; then
    for _psh_svc in @@APP_SERVICES@@; do
        _psh_rc=0
        _psh_err="$(sudo -n @@SYSTEMCTL_PATH@@ try-restart "$_psh_svc" 2>&1)" || _psh_rc=$?
        if [ "$_psh_rc" -ne 0 ]; then
            _psh_reason="$(printf '%s' "$_psh_err" | head -n 1)"
            echo "fusionpbx-ha promote.sh: WARNING: could not restart $_psh_svc (rc=$_psh_rc: ${_psh_reason:-no output}) - requests caught mid-flight to the dead peer hang until TCP timeout" >&2
        fi
    done
    # 0.3.41: refresh the web status snapshot RIGHT HERE - the dashboard
    # must flip within seconds of a failover, not at the next cron tick
    # (the 29.10 bench kept a green "Ok" widget for minutes after node 1
    # died). Runs under the pinned status sudoers verb (postgres -> root,
    # the exact '<script> --write-status'); a failure NEVER affects the
    # promote result - the cron refreshes the file anyway.
    if [ -x '@@STATUS_SCRIPT@@' ]; then
        sudo -n '@@STATUS_SCRIPT@@' --write-status >/dev/null 2>&1 \
            || echo "fusionpbx-ha promote.sh: could not refresh the web status snapshot (the cron will)" >&2
    fi
    exit 0
fi
exit 1
