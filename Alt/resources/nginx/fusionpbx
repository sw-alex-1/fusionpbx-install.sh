
# FusionPBX nginx configuration for Alt Linux
# This file is processed by nginx.sh which replaces placeholder values:
#   {PHP_FPM_SOCKET}  -> actual PHP-FPM socket path
#   {WEB_USER}        -> web server user (e.g., _nginx)

# =============================================================================
# Localhost server block (internal access, no SSL)
# Used by internal services that need to reach FusionPBX without TLS overhead.
# =============================================================================
server {
        listen 127.0.0.1:80;
        server_name 127.0.0.1;
        access_log /var/log/nginx/access.log;
        error_log /var/log/nginx/error.log;

        client_max_body_size 80M;
        client_body_buffer_size 128k;

        location / {
                root /var/www/fusionpbx;
                index index.php;
        }

        location ~ \.php$ {
                fastcgi_pass unix:{PHP_FPM_SOCKET};
                fastcgi_index index.php;
                include fastcgi_params;
                fastcgi_param   SCRIPT_FILENAME /var/www/fusionpbx$fastcgi_script_name;
        }

        # Allow the upgrade routines to run longer than normal
        location = /core/upgrade/index.php {
                fastcgi_pass unix:{PHP_FPM_SOCKET};
                fastcgi_read_timeout 15m;
                fastcgi_index index.php;
                include fastcgi_params;
                fastcgi_param   SCRIPT_FILENAME /var/www/fusionpbx$fastcgi_script_name;
        }

        # Disable viewing sensitive files
        location ~ .htaccess { deny all; }
        location ~ .htpassword { deny all; }
        location ~^.+.(db)$ { deny all; }
        location ~ /\.git { deny all; }
        location ~ /\.lua { deny all; }
        location ~ /\. { deny all; }
}

# =============================================================================
# HTTP server block (port 80)
# Handles LetsEncrypt challenges, SIP phone provisioning, and redirects to HTTPS.
# =============================================================================
server {
        listen [::]:80;
        listen 80;
        server_name fusionpbx;

        #redirect letsencrypt to dehydrated
        location ^~ /.well-known/acme-challenge {
                default_type "text/plain";
                auth_basic "off";
                alias /var/www/dehydrated;
        }

        #rewrite rule - send to https with an exception for provisioning
        if ($uri !~* ^.*(provision|xml_cdr|firmware).*$) {
                rewrite ^(.*) https://$host$1 permanent;
                break;
        }

        #REST api
        if ($uri ~* ^.*/api/.*$) {
                rewrite ^(.*)/api/(.*)$ $1/api/index.php?rewrite_uri=$2 last;
                break;
        }

        #single point of entry
        # FusionPBX 5.6+: requests are routed through public/index.php;
        # the app-internal router handles provision/api/... paths itself,
        # so the old per-vendor nginx rewrite rules are no longer needed
        location / {
                root /var/www/fusionpbx/public;
                index index.php;
                try_files $uri $uri/ /public/index.php?$query_string;
        }

        #multiple points of entry (legacy mode, still supported by FusionPBX)
        #location / {
        #       root /var/www/fusionpbx;
        #       index index.php;
        #}

        access_log /var/log/nginx/access.log;
        error_log /var/log/nginx/error.log;

        client_max_body_size 80M;
        client_body_buffer_size 128k;

        location ~ \.php$ {
                fastcgi_pass unix:{PHP_FPM_SOCKET};
                fastcgi_read_timeout 15m;
                fastcgi_index index.php;
                include fastcgi_params;
                fastcgi_param   SCRIPT_FILENAME /var/www/fusionpbx$fastcgi_script_name;
        }

        # Allow the upgrade routines to run longer than normal
        location = /core/upgrade/index.php {
                fastcgi_pass unix:{PHP_FPM_SOCKET};
                fastcgi_read_timeout 15m;
                fastcgi_index index.php;
                include fastcgi_params;
                fastcgi_param   SCRIPT_FILENAME /var/www/fusionpbx$fastcgi_script_name;
        }

        # Disable viewing sensitive files
        location ~ .htaccess { deny all; }
        location ~ .htpassword { deny all; }
        location ~^.+.(db)$ { deny all; }
        location ~ /\.git { deny all; }
        location ~ /\.lua { deny all; }
        location ~ /\. { deny all; }
}

# =============================================================================
# HTTPS server block (port 443)
# Main FusionPBX web interface with TLS.
# TLS configuration follows Mozilla Modern guidelines (bug #6 fix from analysis).
# =============================================================================
server {
        listen [::]:443 ssl;
        listen 443 ssl;
        server_name fusionpbx;

        # Self-signed certificate (generated by nginx.sh)
        # Will be replaced by LetsEncrypt if letsencrypt.sh is run later
        ssl_certificate         /etc/nginx/ssl/nginx.crt;
        ssl_certificate_key     /etc/nginx/ssl/nginx.key;

        # TLS configuration - Modern profile (no TLSv1, TLSv1.1)
        # Fix for bug #6 from original analysis: removed insecure TLSv1, TLSv1.1
        ssl_protocols           TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;
        ssl_ciphers             ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
        ssl_session_cache       shared:SSL:40m;
        ssl_session_timeout     2h;
        ssl_session_tickets     off;

        #redirect websockets
        # Alt Linux: port 8080 is occupied by Alterator (system config tool).
        # FusionPBX WebSocket uses port {WEBSOCKET_PORT} instead (see config.conf).
        location /websockets/ {
                proxy_pass http://127.0.0.1:{WEBSOCKET_PORT};
                proxy_http_version 1.1;
                proxy_set_header Upgrade $http_upgrade;
                proxy_set_header Connection "upgrade";
                proxy_set_header Host $host;
        }

        #redirect letsencrypt to dehydrated
        location ^~ /.well-known/acme-challenge {
                default_type "text/plain";
                auth_basic "off";
                alias /var/www/dehydrated;
        }

